<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="TopProductsReport" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">
	<queryString>
		<![CDATA[SELECT p.name AS product_name, SUM(si.qty) AS total_sold, SUM(si.subtotal) AS total_revenue, p.stock_qty AS remaining_stock FROM sale_item si JOIN product p ON si.product_id = p.product_id GROUP BY p.product_id, p.name, p.stock_qty ORDER BY total_sold DESC]]>
	</queryString>
	<field name="product_name" class="java.lang.String"/>
	<field name="total_sold" class="java.lang.Long"/>
	<field name="total_revenue" class="java.lang.Double"/>
	<field name="remaining_stock" class="java.lang.Integer"/>
	<title>
		<band height="110">
			<rectangle>
				<reportElement x="0" y="0" width="555" height="110" backcolor="#0D0020" forecolor="#0D0020" mode="Opaque"/>
			</rectangle>
			<staticText>
				<reportElement x="0" y="8" width="555" height="45" forecolor="#FFFFFF" backcolor="#0D0020" mode="Opaque"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="SansSerif" size="22" isBold="true"/>
				</textElement>
				<text><![CDATA[SUPERMARKET MANAGEMENT SYSTEM]]></text>
			</staticText>
			<rectangle>
				<reportElement x="100" y="53" width="355" height="3" backcolor="#9B59B6" forecolor="#9B59B6" mode="Opaque"/>
			</rectangle>
			<staticText>
				<reportElement x="0" y="60" width="555" height="28" forecolor="#9B59B6" backcolor="#0D0020" mode="Opaque"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="SansSerif" size="15" isBold="true"/>
				</textElement>
				<text><![CDATA[Top Selling Products Report]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="88" width="555" height="20" forecolor="#888888" backcolor="#0D0020" mode="Opaque"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="SansSerif" size="9"/>
				</textElement>
				<text><![CDATA[Generated by Supermarket Sales Management System]]></text>
			</staticText>
		</band>
	</title>
	<columnHeader>
		<band height="35">
			<rectangle>
				<reportElement x="0" y="0" width="555" height="35" backcolor="#6C3483" forecolor="#6C3483" mode="Opaque"/>
			</rectangle>
			<staticText>
				<reportElement x="0" y="0" width="160" height="35" forecolor="#FFFFFF" backcolor="#6C3483" mode="Opaque"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="SansSerif" size="11" isBold="true"/>
				</textElement>
				<text><![CDATA[Product Name]]></text>
			</staticText>
			<staticText>
				<reportElement x="160" y="0" width="120" height="35" forecolor="#FFFFFF" backcolor="#6C3483" mode="Opaque"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="SansSerif" size="11" isBold="true"/>
				</textElement>
				<text><![CDATA[Total Sold]]></text>
			</staticText>
			<staticText>
				<reportElement x="280" y="0" width="140" height="35" forecolor="#FFFFFF" backcolor="#6C3483" mode="Opaque"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="SansSerif" size="11" isBold="true"/>
				</textElement>
				<text><![CDATA[Total Revenue]]></text>
			</staticText>
			<staticText>
				<reportElement x="420" y="0" width="135" height="35" forecolor="#FFFFFF" backcolor="#6C3483" mode="Opaque"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="SansSerif" size="11" isBold="true"/>
				</textElement>
				<text><![CDATA[Remaining Stock]]></text>
			</staticText>
		</band>
	</columnHeader>
	<detail>
		<band height="28">
			<textField>
				<reportElement x="0" y="0" width="160" height="28"/>
				<textElement textAlignment="Left" verticalAlignment="Middle">
					<font fontName="SansSerif" size="10"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA[$F{product_name}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="160" y="0" width="120" height="28" forecolor="#9B59B6"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="SansSerif" size="10" isBold="true"/>
				</textElement>
				<textFieldExpression class="java.lang.Long"><![CDATA[$F{total_sold}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="280" y="0" width="140" height="28" forecolor="#27AE60"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="SansSerif" size="10" isBold="true"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA["Rs. " + String.format("%.2f", $F{total_revenue})]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="420" y="0" width="135" height="28" forecolor="#E74C3C"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="SansSerif" size="10" isBold="true"/>
				</textElement>
				<textFieldExpression class="java.lang.Integer"><![CDATA[$F{remaining_stock}]]></textFieldExpression>
			</textField>
			<line>
				<reportElement x="0" y="27" width="555" height="1" forecolor="#E8DAEF"/>
			</line>
		</band>
	</detail>
	<summary>
		<band height="50">
			<rectangle>
				<reportElement x="0" y="10" width="555" height="35" backcolor="#0D0020" forecolor="#0D0020" mode="Opaque"/>
			</rectangle>
			<staticText>
				<reportElement x="0" y="10" width="555" height="35" forecolor="#9B59B6" backcolor="#0D0020" mode="Opaque"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="SansSerif" size="10" isBold="true"/>
				</textElement>
				<text><![CDATA[--- End of Top Selling Products Report ---]]></text>
			</staticText>
		</band>
	</summary>
</jasperReport>