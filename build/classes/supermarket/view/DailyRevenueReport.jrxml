<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="DailyRevenueReport" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">
	<queryString>
		<![CDATA[SELECT DATE(sale_date) AS sale_day, COUNT(*) AS total_transactions, SUM(total_amount) AS daily_revenue, cashier_name FROM sale WHERE DATE(sale_date) >= CURDATE() GROUP BY DATE(sale_date), cashier_name ORDER BY sale_day DESC]]>
	</queryString>
	<field name="sale_day" class="java.sql.Date"/>
	<field name="total_transactions" class="java.lang.Long"/>
	<field name="daily_revenue" class="java.lang.Double"/>
	<field name="cashier_name" class="java.lang.String"/>
	<title>
		<band height="110">
			<rectangle>
				<reportElement x="0" y="0" width="555" height="110" backcolor="#3B5570" forecolor="#3B5570" mode="Opaque"/>
			</rectangle>
			<staticText>
				<reportElement x="0" y="8" width="555" height="45" forecolor="#FFFFFF" backcolor="#3B5570" mode="Opaque"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="SansSerif" size="22" isBold="true"/>
				</textElement>
				<text><![CDATA[SUPERMARKET MANAGEMENT SYSTEM]]></text>
			</staticText>
			<rectangle>
				<reportElement x="100" y="53" width="355" height="3" backcolor="#E79DB0" forecolor="#E79DB0" mode="Opaque"/>
			</rectangle>
			<staticText>
				<reportElement x="0" y="60" width="555" height="28" forecolor="#E79DB0" backcolor="#3B5570" mode="Opaque"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="SansSerif" size="15" isBold="true"/>
				</textElement>
				<text><![CDATA[Daily Revenue Report]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="88" width="555" height="20" forecolor="#88A4A7" backcolor="#3B5570" mode="Opaque"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="SansSerif" size="9"/>
				</textElement>
				<text><![CDATA[Generated by Supermarket Sales Management System]]></text>
			</staticText>
		</band>
	</title>
	<columnHeader>
		<band height="35">
			<rectangle>
				<reportElement x="0" y="0" width="555" height="35" backcolor="#E79DB0" forecolor="#E79DB0" mode="Opaque"/>
			</rectangle>
			<staticText>
				<reportElement x="0" y="0" width="120" height="35" forecolor="#FFFFFF" backcolor="#E79DB0" mode="Opaque"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="SansSerif" size="11" isBold="true"/>
				</textElement>
				<text><![CDATA[Date]]></text>
			</staticText>
			<staticText>
				<reportElement x="120" y="0" width="145" height="35" forecolor="#FFFFFF" backcolor="#E79DB0" mode="Opaque"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="SansSerif" size="11" isBold="true"/>
				</textElement>
				<text><![CDATA[Cashier Name]]></text>
			</staticText>
			<staticText>
				<reportElement x="265" y="0" width="145" height="35" forecolor="#FFFFFF" backcolor="#E79DB0" mode="Opaque"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="SansSerif" size="11" isBold="true"/>
				</textElement>
				<text><![CDATA[Total Transactions]]></text>
			</staticText>
			<staticText>
				<reportElement x="410" y="0" width="145" height="35" forecolor="#FFFFFF" backcolor="#E79DB0" mode="Opaque"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="SansSerif" size="11" isBold="true"/>
				</textElement>
				<text><![CDATA[Revenue (Rs.)]]></text>
			</staticText>
		</band>
	</columnHeader>
	<detail>
		<band height="28">
			<textField>
				<reportElement x="0" y="0" width="120" height="28"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="SansSerif" size="10"/>
				</textElement>
				<textFieldExpression><![CDATA[$F{sale_day}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="120" y="0" width="145" height="28"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="SansSerif" size="10"/>
				</textElement>
				<textFieldExpression><![CDATA[$F{cashier_name}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="265" y="0" width="145" height="28"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="SansSerif" size="10"/>
				</textElement>
				<textFieldExpression><![CDATA[$F{total_transactions}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="410" y="0" width="145" height="28" forecolor="#7A3A65"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="SansSerif" size="10" isBold="true"/>
				</textElement>
				<textFieldExpression><![CDATA[String.format("Rs. %.2f", $F{daily_revenue})]]></textFieldExpression>
			</textField>
			<line>
				<reportElement x="0" y="27" width="555" height="1" forecolor="#E79DB0"/>
			</line>
		</band>
	</detail>
	<summary>
		<band height="50">
			<rectangle>
				<reportElement x="0" y="10" width="555" height="35" backcolor="#3B5570" forecolor="#3B5570" mode="Opaque"/>
			</rectangle>
			<staticText>
				<reportElement x="0" y="10" width="555" height="35" forecolor="#E79DB0" backcolor="#3B5570" mode="Opaque"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="SansSerif" size="10" isBold="true"/>
				</textElement>
				<text><![CDATA[--- End of Daily Revenue Report ---]]></text>
			</staticText>
		</band>
	</summary>
</jasperReport>
